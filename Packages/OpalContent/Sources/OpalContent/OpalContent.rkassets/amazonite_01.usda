#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

# One gem (amazonite_01): its mesh, bound to its own copy of the shared Opal material.
# The material references Scene.usda's OpalMaterial, so the graph lives in one place and this
# file only overrides what differs for this gem: the textures, plus any of the float inputs
# (RimStrength, HueRange, FlashStrength, FlashSwing, PatchScale, ShimmerSpeed, Roughness) and
# RimColor. Inputs not overridden here keep the graph's defaults.
def Xform "Root"
{
    def Material "Amazonite_01_Material" (
        references = @Scene.usda@</Root/OpalMaterial>
    )
    {
        asset inputs:BaseColorTexture = @amazonite_01_base.png@
        asset inputs:EmissionTexture = @amazonite_01_emission.png@
        float inputs:FlashStrength = 0.3
        float inputs:FlashSwing = 1
        float inputs:HueRange = 0.01
        float inputs:PatchScale = 8
        color3f inputs:RimColor = (0.8, 1, 0.95) (
            colorSpace = "srgb_displayp3"
        )
        float inputs:RimStrength = 0.25
        float inputs:Roughness = 0.3
        float inputs:ShimmerSpeed = 0.05
    }

    def "Gem" (
        active = true
        prepend apiSchemas = ["MaterialBindingAPI"]
        references = @amazonite_01_model.usdz@
    )
    {
        rel material:binding = None (
            bindMaterialAs = "weakerThanDescendants"
        )
        quatf xformOp:orient = (0.70710677, -0.70710677, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        float3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "Gem_amazonite"
        {
            over "Gem_amazonite" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Root/Amazonite_01_Material> (
                    bindMaterialAs = "weakerThanDescendants"
                )
            }
        }
    }
}
